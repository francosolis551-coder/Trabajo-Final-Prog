void Actualizar_asignacion(Asignaciones listaA[], int cantA) {

	string DNI, Codigo_proy;
	int guardar_pocicion_Especialista = -1, guardar_pocicion_proy = -1;
	bool existe_especialista = false, existe_proy = false, proy_especialista_en_uno = false;

	cout << "Selecciono: Actualizar asignacion!" << endl;
	cout << "=========================================" << endl;
	do
	{
		guardar_pocicion_Especialista = -1;
		guardar_pocicion_proy = -1;
		existe_especialista = false;
		existe_proy = false;
		proy_especialista_en_uno = false;
		do
		{
			cout << "ingresa DNI del especialista asignado: ";
			cin >> DNI;
			if (ContarCaracteres(DNI) == 8 && SoloDigitos(DNI))
			{
				for (int i = 0; i < cantA; i++)
				{
					if (listaA[i].DNI_Especialista == DNI)
					{
						existe_especialista = true;
						guardar_pocicion_Especialista = i;
						break;

					}
				}
				break;
			}
			else
			{
				cout << "DNI invalido,introducir el DNI de uno de los especialistas ya registrados." << endl;
			}
		} while (true);

		do
		{
			cout << "Ingresar el codigo del Proyecto del Especialista: ";
			cin >> Codigo_proy;
			Codigo_proy = Primera_letra_mayuscula(Codigo_proy);
			//validar existencia del protecto
			if (listaA[cantA].Codigo_Proy[0] == 'P' && listaA[cantA].Codigo_Proy[1] == '-' && ContarCaracteres(listaA[cantA].Codigo_Proy) > 0 && ContarCaracteres(listaA[cantA].Codigo_Proy) <= 5)
			{
				for (int i = 0; i < cantA; i++)
				{
					if (listaA[i].Codigo_Proy == Codigo_proy) {
						existe_proy = true;
						guardar_pocicion_proy = i;
						break;
					}
				}
				break;
			}
			else
			{
				cout << "Codigo invalido, por favor introducir un codigo de proyecto" << endl;
			}
		} while (true);

		//validar que el proyecto tenga al especialista	mencionado
		if (guardar_pocicion_Especialista == guardar_pocicion_proy && listaA[guardar_pocicion_Especialista].Estado_Asignacion == "Activa") {
			proy_especialista_en_uno = true;
		}
		else
		{
			cout << "[ERROR], Verificar que el Especialista este en el proyecto mencionado y aun este activo." << endl;
		}

		if (proy_especialista_en_uno && existe_especialista && existe_proy)
		{
			//actualizar
			listaA[guardar_pocicion_Especialista].Estado_Asignacion = "Finalizada";
			cout << "Estado, Actualizado a Finalizada" << endl;
			break;
		}
	} while (true);
}

