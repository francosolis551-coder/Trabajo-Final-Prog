void main() {

	int opcion = 0, cant = 0, cantM = 3, cantE = 4;
	int cantP = 3, cantA = 3; // <-- añadi estas 3 (1/3) -G
	int miniMenu = 0;
	cant = 200;

	Monumentos* Estructuras = new Monumentos[cant];
	Especialistas* especialistas = new Especialistas[cant];
	Proyectos_Conservacion* proyectos = new Proyectos_Conservacion[cant]; // <-- añadi estas 3 (2/3) -G
	Asignaciones* Asignacion_Epecialista_Proyecto = new Asignaciones[cant];

	MonumentosHistoricosYaRegistrados(Estructuras, cantM);
	Especialistas_Registrados(especialistas, cantE);
	ProyectosRegistrados(proyectos, cantP); // <-- añadi estas 3 (3/3) -G
	Asignaciones_Registradas(Asignacion_Epecialista_Proyecto, cantA);

	while (true) {
		opcion = Menu();

		if (opcion == 7) {
			cout << "Saliendo...";
			break;
		}

		if (opcion == 1) {
			RegistroMonumento(Estructuras, cantM);
			cantM++;
		}
		else if (opcion == 2) {
			RegistroEspecialista(especialistas, cantE);
			cantE++;
		}
		else if (opcion == 3)
		{
			RegistroProyecto(proyectos, cantP, Estructuras, cantM);
			cantP++;
		}
		else if (opcion == 4) {
			miniMenu = mini_menu();
			if (miniMenu == 1) {
				if (Asignar_especialista_a_proyecto_conservacion(Asignacion_Epecialista_Proyecto, cantA, especialistas, cantE, proyectos, cantP, Estructuras, cantM)) {
					cantA++;
				};
			}
			else if (miniMenu == 2)
			{
				Actualizar_asignacion(Asignacion_Epecialista_Proyecto, cantA);
			}
			else
			{
				cout << "Saliendo de asignaciones....." << endl;
			}
		}
		else if (opcion == 5) {
			Reporte_1(Asignacion_Epecialista_Proyecto, proyectos, Estructuras, especialistas, cantP);
		}
	}

	delete[] Estructuras;
	delete[] especialistas;
	delete[] proyectos;
	delete[] Asignacion_Epecialista_Proyecto;

	getch();
}
