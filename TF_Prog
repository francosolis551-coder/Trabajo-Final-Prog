/*---------------------------------------------------AUXILIARES--------------------------------------------------------------*/

int ContarCaracteres(string texto) {
	int cantidad = texto.length();
	return cantidad;
}
bool SoloDigitos(string texto) {
	if (ContarCaracteres(texto) == 0) {
		return false;
	}

	for (int i = 0; i < ContarCaracteres(texto); i++) {
		if (!isdigit(texto[i])) {
			return false;
		}
	}

	return true;
}
bool TieneDigitos(string texto) {
	for (int i = 0; i < ContarCaracteres(texto); i++) {
		if (isdigit(texto[i])) {
			return true;
		}
	}

	return false;
}
string Primera_letra_mayuscula(string texto) {

	texto[0] = toupper(texto[0]);

	return texto;
}

int Fecha_numero(int anio, int mes, int dia) {
	int Fecha = 0;
	Fecha = anio * 10000 + mes * 100 + dia;
	return Fecha;
}



